TRIPADVISOR_API_KEY=your_api_key_here
# Local estimate: one per HTTP attempt, based on this Discover account's Dashboard observation.
# 1000: initial free allowance reference; Dashboard is the final billing authority.
# 1300: permits approximately 300 paid entities beyond the initial 1000.
# Built-in default remains 800; set this explicitly after reviewing usage.
HARD_ENTITY_BUDGET=1000
# Optional: replace with a compatible private/provider Nominatim search endpoint.
GEOCODING_URL=https://nominatim.openstreetmap.org/search
